# Novae environment-variable checklist
# Copy only the frontend section to .env.local for manual frontend development.
# Never commit real values. GitHub deployment values belong in the production
# and development Environments, not in repository-level plaintext variables.

# Browser-visible frontend values (NEXT_PUBLIC_* values are not secrets)
NEXT_PUBLIC_SCHOOL_NAME=你的學校名稱
NEXT_PUBLIC_ALLOWED_DOMAIN=school.edu.tw
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FIREBASE_APP_CHECK_ENABLED=false
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_API_BASE_URL=https://novae-api.<你的-workers-subdomain>.workers.dev

# Local emulator convenience only; never enable in a deployment.
NEXT_PUBLIC_LOCAL_DEV_AUTH=false
NEXT_PUBLIC_LOCAL_DEV_AUTH_EMAIL=admin@integration.invalid

# Firebase backend credentials
FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_NUMBER=
FIREBASE_APP_IDS=
FIREBASE_WEB_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Neon owner connection and the separate password used by novae_runtime.
# NEON_DATABASE_URL must be the direct, SSL-enabled owner URL, not the pooled URL.
NEON_DATABASE_URL=
NEON_RUNTIME_PASSWORD=

# Cloudflare account/deployment configuration
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_HYPERDRIVE_ID=
CLOUDFLARE_WORKER_URL=https://novae-api.<你的-workers-subdomain>.workers.dev
# Optional GitHub Environment variables; defaults are novae-api/novae-jobs in production.
CLOUDFLARE_WORKER_NAME=novae-api
CLOUDFLARE_QUEUE_NAME=novae-jobs
ALLOWED_ORIGINS=https://你的正式網域

# Worker access control and private runtime values
ALLOWED_DOMAIN=school.edu.tw
ADMIN_EMAILS=admin@school.edu.tw
HEALTHCHECK_SECRET=
MEDIA_SIGNING_SECRET=
REALTIME_TICKET_SECRET=
TURNSTILE_SECRET_KEY=

# Cloudinary signed uploads, authenticated originals, and webhook verification.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Notion operational copy; leave all three empty to disable it.
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_DATA_SOURCE_ID=

# Vercel GitHub Actions deployment credentials
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=

# GitHub Environment variable for encrypted daily backups (public recipient only).
BACKUP_AGE_RECIPIENT=age1...
