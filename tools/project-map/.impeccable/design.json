      "refersTo": "button-theme",
      "description": "目錄工具名稱旁的主色控制。",
      "html": "<button class=\"ds-theme\" aria-label=\"切換亮暗色\">深色</button>",
      "css": ".ds-theme{font-family:system-ui, \"Microsoft JhengHei\", sans-serif;font-size:12px;line-height:1.7;background:var(--wash);color:var(--accent);border:0;border-radius:14px;padding:6px 10px;white-space:nowrap;cursor:pointer}.ds-theme:hover,.ds-theme:active{background:var(--wash);color:var(--accent)}.ds-theme:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
