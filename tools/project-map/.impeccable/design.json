  "components": [
    {
      "name": "一般按鈕",
      "kind": "button",
      "refersTo": "button-default",
      "description": "一般操作與上／下一步控制。",
      "html": "<button class=\"ds-button\">下一步</button>",
      "css": ".ds-button{font-family:system-ui, \"Microsoft JhengHei\", sans-serif;font-size:14px;line-height:1.7;color:var(--ink);background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:8px 12px;cursor:pointer}.ds-button:hover:not(:disabled),.ds-button:active:not(:disabled){background:var(--wash);color:var(--accent)}.ds-button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-button:disabled{opacity:.45;cursor:default}"
    },
    {
      "name": "亮暗色按鈕",
