{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/app/**/{page,layout,route,manifest,sw}.{ts,tsx}",
        "cloudflare/src/index.ts",
        "scripts/*.mjs",
        "tests/**/*.{ts,mjs}",
        "tools/**/*.{js,mjs}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "src/**/*.css",
        "cloudflare/**/*.ts",
        "scripts/**/*.mjs",
        "tests/**/*.{ts,mjs}"
      ],
      "ignore": [
        "src/generated/**"
      ]
    },
    "tools/next-root-glob": {}
  },
  "ignoreDependencies": [
    "harmonyos-sans-webfont-splitted",
    "@babel/preset-react",
    "@babel/preset-typescript",
    "client-only",
    "cloudflare"
  ],
  "ignoreBinaries": [
    "wsl.exe",
    "taskkill.exe",
    "netstat.exe"
  ]
}
