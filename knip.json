{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/app/main.tsx",
        "src/app/sw.ts",
        "vite.config.ts",
        "cloudflare/src/index.ts",
        "scripts/*.mjs",
        "tests/**/*.{ts,mjs}"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "src/**/*.css",
        "cloudflare/**/*.ts",
        "scripts/**/*.mjs",
        "tests/**/*.{ts,mjs}"
      ],
      "ignore": [
        "src/generated/**"
      ]
    }
  },
  "ignoreDependencies": [
    "harmonyos-sans-webfont-splitted",
    "@babel/preset-react",
    "@babel/preset-typescript",
    "cloudflare"
  ],
  "ignoreBinaries": [
    "wsl.exe",
    "taskkill.exe",
    "netstat.exe"
  ]
}
