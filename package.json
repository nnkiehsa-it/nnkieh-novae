{
  "name": "novae",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bun": ">=1.4 <2",
    "node": ">=24 <25"
  },
  "packageManager": "bun@1.4.0",
  "overrides": {
    "browserslist": "4.28.7",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "generate:api-errors": "node scripts/generate-api-errors.mjs",
    "generate:rate-limits": "node scripts/generate-rate-limits.mjs",
    "generate:data-retention": "node scripts/generate-data-retention.mjs",
    "generate:backend-actions": "node scripts/generate-backend-actions.mjs",
    "generate:database-contracts": "node scripts/generate-database-contracts.mjs",
    "generate:harmonyos-font": "node scripts/generate-harmonyos-subset.mjs",
    "generate:all": "node scripts/generate-all.mjs",
    "build": "tsc --noEmit && next build --webpack",
    "build:deploy": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:worker": "tsc -p cloudflare/tsconfig.json --noEmit",
    "check:integration-types": "tsc -p tsconfig.integration.json --noEmit",
    "check:unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:ui": "node scripts/check-ui-primitives.mjs",
    "check:build-budget": "node scripts/check-build-budget.mjs",
    "verify:local": "node scripts/run-local-verification.mjs",
    "verify:fast": "node scripts/run-local-verification.mjs --fast",
    "verify:data-consistency": "node scripts/verify-data-consistency.mjs",
    "verify:database-contracts": "node scripts/generate-database-contracts.mjs --check",
    "verify:integration": "node scripts/verify-integration.mjs",
    "test:e2e": "node scripts/verify-integration.mjs --e2e",
    "test:e2e:runner": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "verify:stress": "node scripts/verify-integration.mjs --stress-scale 8",
    "test:env": "node scripts/verify-integration.mjs --serve",
    "verify:all": "node scripts/run-local-verification.mjs --all",
    "test:architecture": "node scripts/run-local-verification.mjs --architecture-only",
    "test:tooling": "node scripts/run-local-verification.mjs --tooling-only",
    "test:unit": "node scripts/run-local-verification.mjs --unit-only",
    "test": "node scripts/run-local-verification.mjs --test-only",
    "db:start": "node scripts/database.mjs start-local",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:configure-runtime": "node scripts/configure-database-runtime.mjs",
    "db:reset:local": "node scripts/database.mjs reset-local --seed",
    "db:seed:local": "node scripts/database.mjs seed-local",
    "db:status": "node scripts/database.mjs status",
    "db:stop": "node scripts/database.mjs stop-local"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@jsquash/webp": "1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "3.4.13",
    "firebase": "12.17.1",
    "harmonyos-sans-webfont-splitted": "^1.2.1",
    "jose": "6.2.8",
    "lucide-react": "^0.539.0",
    "marked": "18.0.9",
    "motion": "13.1.0",
    "next": "16.3.0",
    "next-themes": "0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.8"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.6",
    "@babel/parser": "7.29.8",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@cloudflare/workers-types": "^5.20260815.1",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@serwist/next": "9.5.12",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "24.13.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "serwist": "9.5.12",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "^4.123.0"
  }
}
