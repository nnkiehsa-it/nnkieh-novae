{
  "name": "novae",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "generate:api-errors": "node scripts/generate-api-errors.mjs",
    "generate:rate-limits": "node scripts/generate-rate-limits.mjs",
    "generate:data-retention": "node scripts/generate-data-retention.mjs",
    "generate:backend-actions": "node scripts/generate-backend-actions.mjs",
    "generate:all": "npm run generate:api-errors && npm run generate:rate-limits && npm run generate:data-retention && npm run generate:backend-actions",
    "pretypecheck": "npm run generate:all",
    "prelint": "npm run generate:all",
    "prebuild": "npm run generate:all",
    "build": "vue-tsc -b && vite build --config vite.config.ts",
    "build:deploy": "vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .ts,.vue",
    "check:edge": "deno check --no-lock supabase/functions/outboxWorker/index.ts supabase/functions/backendAction/index.ts supabase/functions/syncUser/index.ts supabase/functions/cloudinaryWebhook/index.ts supabase/functions/processDeletionJobs/index.ts supabase/functions/maintenanceCleanup/index.ts",
    "check:worker": "tsc -p cloudflare/tsconfig.json --noEmit",
    "check:unused": "vue-tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:ui": "node scripts/check-ui-primitives.mjs",
    "check:build-budget": "node scripts/check-build-budget.mjs",
    "verify:local": "node scripts/run-local-verification.mjs",
    "verify:integration": "node scripts/verify-integration-local.mjs",
    "test:e2e": "node scripts/verify-integration-local.mjs --e2e",
    "test:e2e:runner": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "verify:stress": "node scripts/verify-integration-local.mjs --stress-scale 8",
    "test:env": "node scripts/verify-integration-local.mjs --serve",
    "verify:all": "node scripts/run-local-verification.mjs --all",
    "test:architecture": "node scripts/run-local-verification.mjs --architecture-only",
    "test:unit": "node scripts/run-local-verification.mjs --unit-only",
    "test": "node scripts/run-local-verification.mjs --test-only",
    "db:start": "supabase start",
    "db:reset:local": "supabase db reset --local",
    "db:lint:local": "supabase db lint --local"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "@lucide/vue": "^1.28.0",
    "@supabase/postgrest-js": "2.110.7",
    "@supabase/supabase-js": "2.110.7",
    "@vueuse/core": "14.4.0",
    "dompurify": "3.4.13",
    "firebase": "12.16.0",
    "harmonyos-sans-webfont-splitted": "^1.2.1",
    "jose": "6.2.5",
    "marked": "18.0.7",
    "modern-screenshot": "4.7.0",
    "motion-v": "2.3.0",
    "reka-ui": "2.10.1",
    "vue": "3.5.40",
    "vue-router": "5.2.0",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@typescript-eslint/parser": "8.65.0",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/compiler-sfc": "^3.5.40",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "deno": "2.9.4",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "google-auth-library": "^10.9.1",
    "jsdom": "30.0.1",
    "postcss": "8.5.25",
    "supabase": "2.110.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  }
}
